# Optional. Never put credentials in source files or reports.
# Public sources run without these. Leave missing credentials blank.
YOUTUBE_API_KEY=
REDDIT_ACCESS_TOKEN=
# Broad discovery is the default. "communities" selects only chronological New feeds.
REDDIT_DISCOVERY=broad
# Individual community Rising feeds drive discovery. Public RSS is used without a token.
REDDIT_COMMUNITIES=news,gaming,movies,sports,technology,memes,worldnews,games,television,nba,politics,Music,nfl,dankmemes,OutOfTheLoop
X_BEARER_TOKEN=

# Local tracker settings (optional)
TREND_PORT=8794
# TREND_DB_PATH=C:/path/to/persistent/trends.sqlite
